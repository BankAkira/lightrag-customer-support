# Custom LightRAG Dockerfile (OPTIONAL)
#
# This file is NOT used by default. The docker-compose.yml uses the official
# image: ghcr.io/hkuds/lightrag:latest
#
# Use this Dockerfile only if you need to customize the LightRAG installation,
# add extra dependencies, or modify the base image.
#
# To use this custom Dockerfile:
# 1. Uncomment the 'build' section in docker-compose.yml for the lightrag service
# 2. Comment out or remove the 'image: ghcr.io/hkuds/lightrag:latest' line
# 3. Run: docker-compose build lightrag

# Start from the official LightRAG image
FROM ghcr.io/hkuds/lightrag:latest

# Example: Install additional system dependencies
# RUN apt-get update && apt-get install -y \
#     your-package-here \
#     && rm -rf /var/lib/apt/lists/*

# Example: Install additional Python packages
# RUN pip install --no-cache-dir \
#     your-python-package

# Example: Copy custom configuration or scripts
# COPY custom_config.py /app/
# COPY custom_entrypoint.sh /app/
# RUN chmod +x /app/custom_entrypoint.sh

# The official image already exposes port 9621 and sets the correct entrypoint
# No need to modify unless you have custom requirements
