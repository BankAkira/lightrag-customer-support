# LLM Configuration (vLLM with Typhoon 2.5)
LLM_MODEL_NAME=scb10x/typhoon-v2.5-instruct
LLM_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=dummy
LLM_MAX_TOKENS=32768
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9

# Embedding Configuration (BGE-M3 for multilingual support)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=http://embedding:80
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_ASYNC=16

# Reranker Configuration (BGE Reranker V2 M3)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=http://reranker:80
ENABLE_RERANK=true

# Storage Configuration (PostgreSQL for all storage types)
KV_STORAGE=PGKVStorage
VECTOR_STORAGE=PGVectorStorage
GRAPH_STORAGE=PGGraphStorage
DOC_STATUS_STORAGE=PGDocStatusStorage

# PostgreSQL Configuration
# IMPORTANT: Change the password before deploying to production!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
POSTGRES_DATABASE=lightrag

# LightRAG Core Configuration
WORKING_DIR=/app/lightrag_data
WORKSPACE=customer_support
CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP_TOKEN_SIZE=100
ENTITY_EXTRACT_MAX_GLEANING=1
MAX_ASYNC=4
MAX_EMBED_TOKENS=8192

# Query Configuration
TOP_K=60
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
COSINE_THRESHOLD=0.2

# Cache Configuration
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_ENTITY_EXTRACT=true

# Language and Entity Configuration for Thai/English support
LANGUAGE=Thai and English
ENTITY_TYPES=["organization", "person", "product", "service", "location", "event", "issue", "feature", "solution"]

# Server Configuration
HOST=0.0.0.0
PORT=9621

# Logging
LOG_LEVEL=INFO
